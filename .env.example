# Server binding
HOST=127.0.0.1
PORT=4567

# Local development defaults
# Set to 1/true/yes/on to disable mutating API routes and hide write controls.
CODEX_CONTROL_READ_ONLY=0

# Optional built-in Basic Auth.
# Keep disabled for trusted localhost use, or enable when exposing behind a trusted network.
CODEX_CONTROL_AUTH=none
# CODEX_CONTROL_AUTH_USER=admin
# CODEX_CONTROL_AUTH_PASSWORD=
# CODEX_CONTROL_AUTH_PASSWORD_SHA256=
# CODEX_CONTROL_ALLOW_UNAUTHENTICATED_NETWORK=0

# Local file serving policy:
# - session: follow session/worktree permissions
# - system: serve any local file path the process can read
CODEX_CONTROL_FILE_SERVING=session

# Development-only restart support
# CODEX_CONTROL_DEV_RESTART=1
# CODEX_CONTROL_RESTART_TASK=
