{
  "name": "codex-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "restart": "npm run restart:windows",
    "restart:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/restart-codex-control.ps1"
  },
  "engines": {
    "node": ">=18"
  }
}
