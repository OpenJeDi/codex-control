{
  "workspaceRoots": [
    "C:/Users/you/work"
  ],
  "requiredWorktreeRoot": "{canonicalWorktreeRoot}",
  "defaultWorktreeWorkflow": "bare-container",
  "worktreeWorkflows": {
    "posix-bare-container": {
      "label": "POSIX bare repo container with worktrees",
      "branchWorktree": "{requiredWorktreeRoot}/{branchName}"
    },
    "windows-bare-container": {
      "label": "Windows bare repo container with worktrees",
      "branchWorktree": "{requiredWorktreeRoot}/{branchName}"
    },
    "bare-container": {
      "label": "Bare repo container with worktrees",
      "branchWorktree": "{requiredWorktreeRoot}/{branchName}"
    },
    "auto-sibling": {
      "label": "Auto sibling worktrees",
      "branchWorktree": "{autoWorktreeRoot}/{branchName}"
    }
  }
}
